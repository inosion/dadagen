//! Definition of the DSL grammar for parsing.

// Define the start rule - supports both schema wrapper and bare fields
comment = _{ "#" ~ (!NL ~ ANY)* ~ NL }
WSNL_COMMENT = _{ WS | NL | comment }
dsl = { WSNL_COMMENT* ~ (schema_block | field_list) ~ END }

// Field list: field... field...
field_list = { WSNL_COMMENT* ~ field_expr ~ (WSNL_COMMENT* ~ ","? ~ WSNL_COMMENT* ~ field_expr)* ~ (WSNL_COMMENT* ~ ",")? ~ WSNL_COMMENT* }

// Schema block: schema <name> { field... }
schema_block = { "schema" ~ WSNL_COMMENT+ ~ schema_name ~ WSNL_COMMENT* ~ "{" ~ field_list ~ "}" ~ WSNL_COMMENT* }
schema_name = { (ASCII_ALPHANUMERIC | "_" | "-")+ }

// Define a named field (colon form) and hidden field forms
named_field = { quote_string ~ field_name ~ quote_string ~ WSNL* ~ ("hidden" ~ WSNL* ~ ":")? ~ WSNL* ~ ":" ~ WSNL* ~ generator }
hidden_field = { "hidden" ~ WSNL* ~ ":" ~ WSNL* ~ generator }
// A field expression may be a named field or a hidden seed (legacy `field {}` removed)
field_expr = { WSNL_COMMENT* ~ (named_field | hidden_field) ~ WSNL_COMMENT* }

quote_string = _{ "\"" }

// Define all generator types (prioritized by specificity)
base_generator = {
    string_generator
  | string_template_generator
  | boolean_generator
  | datetime_generator
  | date_generator
  | time_generator
  | choice_generator
  | list_generator
  | double_number_generator
  | number_generator
  | gender_generator
  | name_generator
  | address_generator
  | sequence_generator
  | regexgen_generator
}

// Implicit template: quoted string with {{placeholder}} parts
string_template_generator = { quote_string ~ string_template_generator_body* ~ quote_string }
string_template_generator_body = { placeholder | string_template_generator_char }
string_template_generator_char = { !("\"" | "{{") ~ ANY }
placeholder = { "{{" ~ field_name ~ "}}" }

term = _{ base_generator | template_generator }
// Concatenation expression: term (+ term)*
concat_expr = { term ~ (WSNL* ~ "+" ~ WSNL* ~ term)* }
generator = _{ concat_expr }

/* String Generator with constraints */
string_label = { "string" }
string_generator = { 
    string_label ~ WSNL* ~ ("(" ~ WSNL* ~ string_constraints ~ WSNL* ~ ")")? 
}
string_constraints = { string_constraint ~ (WSNL* ~ "," ~ WSNL* ~ string_constraint)* }
string_constraint = _{
    string_length_constraint
  | string_min_length_constraint
  | string_max_length_constraint
  | string_charset_constraint
  | string_case_constraint
  | string_pattern_constraint
}
string_length_constraint = { "length" ~ WSNL* ~ "=" ~ WSNL* ~ number }
string_min_length_constraint = { "min_length" ~ WSNL* ~ "=" ~ WSNL* ~ number }
string_max_length_constraint = { "max_length" ~ WSNL* ~ "=" ~ WSNL* ~ number }
string_charset_constraint = { "charset" ~ WSNL* ~ "=" ~ WSNL* ~ (quote_string ~ charset_type ~ quote_string) }
string_case_constraint = { "case" ~ WSNL* ~ "=" ~ WSNL* ~ (quote_string ~ case_type ~ quote_string) }
string_pattern_constraint = { "pattern" ~ WSNL* ~ "=" ~ WSNL* ~ quote_string ~ pattern_string ~ quote_string }
charset_type = @{ "alphanumeric" | "alpha" | "numeric" | "ascii" | "hex" | "base64" }
case_type = @{ "lower" | "upper" | "title" | "mixed" }
charset_value = { quote_string ~ charset_type ~ quote_string }
case_value = { quote_string ~ case_type ~ quote_string }
pattern_string = { (ASCII_ALPHA | ASCII_DIGIT | ASCII_CHARS | WS)* }

/* Boolean Generator */
boolean_label = { "boolean" | "bool" }
boolean_generator = { 
    boolean_label ~ WSNL* ~ ("(" ~ WSNL* ~ boolean_constraints ~ WSNL* ~ ")")? 
}
boolean_constraints = { boolean_constraint ~ (WSNL* ~ "," ~ WSNL* ~ boolean_constraint)* }
boolean_constraint = _{ boolean_true_probability }
boolean_true_probability = { "true_probability" ~ WSNL* ~ "=" ~ WSNL* ~ (double_number | number) }

/* Date/Time Generators */
datetime_label = { "datetime" }
date_label = { "date" }
time_label = { "time" }
datetime_generator = { 
    datetime_label ~ WSNL* ~ ("(" ~ WSNL* ~ datetime_constraints ~ WSNL* ~ ")")? 
}
date_generator = { 
    date_label ~ WSNL* ~ ("(" ~ WSNL* ~ datetime_constraints ~ WSNL* ~ ")")? 
}
time_generator = { 
    time_label ~ WSNL* ~ ("(" ~ WSNL* ~ datetime_constraints ~ WSNL* ~ ")")? 
}
datetime_constraints = { datetime_constraint ~ (WSNL* ~ "," ~ WSNL* ~ datetime_constraint)* }
datetime_constraint = _{
    datetime_start_constraint
  | datetime_end_constraint
  | datetime_format_constraint
}
datetime_start_constraint = { ("start" | "min") ~ WSNL* ~ "=" ~ WSNL* ~ quote_string ~ datetime_value ~ quote_string }
datetime_end_constraint = { ("end" | "max") ~ WSNL* ~ "=" ~ WSNL* ~ quote_string ~ datetime_value ~ quote_string }
datetime_format_constraint = { "format" ~ WSNL* ~ "=" ~ WSNL* ~ quote_string ~ format_string ~ quote_string }
datetime_value = { (ASCII_ALPHA | ASCII_DIGIT | ":" | "-" | "/" | " " | "T" | "Z")+ }
format_string = { (ASCII_ALPHA | ASCII_DIGIT | "%" | ":" | "-" | "/" | " ")+ }

/* Choice/Enum Generator */
choice_label = { "choice" | "enum" }
choice_generator = { 
    choice_label ~ WSNL* ~ "(" ~ WSNL* ~ choice_options ~ WSNL* ~ ")" 
}
choice_options = { choice_option ~ (WSNL* ~ "," ~ WSNL* ~ choice_option)* }
choice_option = { quote_string ~ choice_value ~ quote_string }
choice_value = { (ASCII_ALPHA | ASCII_DIGIT | ASCII_CHARS | WS)* }

/* List Generator with discriminator support */
list_label = { "list" }
list_generator = { 
  list_label ~ WSNL* ~ "(" ~ WSNL* ~ ( (quote_string ~ list_name_value ~ quote_string ~ (WSNL* ~ "," ~ WSNL* ~ list_constraints)? ) | list_constraints )? ~ WSNL* ~ ")" 
}
list_constraints = { list_constraint ~ (WSNL* ~ "," ~ WSNL* ~ list_constraint)* }
list_constraint = _{
    list_name_constraint
  | list_discriminator_constraint
  | list_mode_constraint
  | list_weighted_constraint
}
list_name_constraint = { "name" ~ WSNL* ~ "=" ~ WSNL* ~ quote_string ~ list_name_value ~ quote_string }
list_discriminator_constraint = { "discriminator" ~ WSNL* ~ "=" ~ WSNL* ~ quote_string ~ field_name ~ quote_string }
list_weighted_constraint = { "weighted" ~ WSNL* ~ "=" ~ WSNL* ~ ("true" | "false") }
list_mode_constraint = { "mode" ~ WSNL* ~ "=" ~ WSNL* ~ ("random" | "sequential") }
// Allow filenames and simple paths (dots, slashes, dashes, underscores)
// Allow spaces inside quoted list names/paths
// Allow backslash for Windows paths too
// Also allow colon for Windows drive letter (C:) and other common filename chars
list_name_value = { (ASCII_ALPHA | ASCII_DIGIT | "." | "-" | "_" | "/" | " " | "\\" | ":")+ }

/* * Number Generator int */
number_generator_label = { "number" }
number_generator       = { 
    number_generator_label ~ WSNL* ~ "(" ~ WSNL* ~ number_constraints ~ WSNL* ~ ")"
  | number_generator_label
}
number_constraints = { number_constraint ~ (WSNL* ~ "," ~ WSNL* ~ number_constraint)* }
number_constraint = _{
    number_min_constraint
  | number_max_constraint
  | number_distribution_constraint
  | number_seed_constraint
  | number_decimal_places_constraint
}
number_min_constraint = { "min" ~ WSNL* ~ "=" ~ WSNL* ~ (double_number | number) }
number_max_constraint = { "max" ~ WSNL* ~ "=" ~ WSNL* ~ (double_number | number) }
number_decimal_places_constraint = { "decimal_places" ~ WSNL* ~ "=" ~ WSNL* ~ number }
number_distribution_constraint = { "distribution" ~ WSNL* ~ "=" ~ WSNL* ~ quote_string ~ distribution_type ~ quote_string }
number_seed_constraint = { "seed" ~ WSNL* ~ "=" ~ WSNL* ~ number }
distribution_type = { "uniform" | "normal" | "exponential" }

/* * Number Generators - float (double) */
double_number_generator    =  { 
  number_generator_label ~ WSNL* ~ "(" ~ WSNL* ~ double_constraints ~ WSNL* ~ ")"
}
double_constraints = { double_constraint ~ (WSNL* ~ "," ~ WSNL* ~ double_constraint)* }
double_constraint = _{
    double_min_constraint
  | double_max_constraint
  | double_decimal_places_constraint
  | number_distribution_constraint
  | number_seed_constraint
}
double_min_constraint = { "min" ~ WSNL* ~ "=" ~ WSNL* ~ double_number }
double_max_constraint = { "max" ~ WSNL* ~ "=" ~ WSNL* ~ double_number }
double_decimal_places_constraint = { "decimal_places" ~ WSNL* ~ "=" ~ WSNL* ~ number }

/* gender (male, female) */
gender_generator_label = { "gender" }
gender_generator       = { gender_generator_label }

/* gender (male, female) */
sequence_label     = { "sequence" }
sequence_generator = { sequence_label }

/* given name, surname */
name_generator_label = { "name" }
given_name_label     = { "givenname" }
surname_label        = { "surname" }
name_generator       = { name_generator_label ~ WSNL+ ~ (given_name_label | surname_label) }

/* address */
address_generator_label = { "address" }
citytown_label          = { "citytown" | "city" | "town" }
suburb_label            = { "suburb" }
street_label            = { "street" }
property_label          = { "property" }
postzipcode_label       = { "postzipcode" }
statecounty_label       = { "statecounty" }
country_label           = { "country" }
address_generator       = { address_generator_label ~ WSNL+ ~ (citytown_label | suburb_label | street_label | property_label | postzipcode_label | statecounty_label | country_label) }

/* Template genrator */
template_label              = { "template" }
generator_template_variable = { "gen:" ~ base_generator }
template_variable           = { "{{" ~ (generator_template_variable | field_name) ~ "}}" }
template_generator          = { template_label ~ WSNL+ ~ quote_string ~ WSNL* ~ (template_variable | template_non_var_characters | WS)* ~ WSNL* ~ quote_string }
template_non_var_characters = { ASCII_ALPHA | ASCII_DIGIT | ASCII_CHARS }

/* regex-gen */
regexgen_label                   = { "regexgen" }
regexgen_generator               = { regexgen_label ~ WSNL+ ~ quote_string ~ WSNL* ~ (regexgen_multiselect_expr | regexgen_range_expr | regexgen_non_expr_characters | WS)* ~ WSNL* ~ quote_string }
regexgen_range_expr              = { ("[" ~ (regexgen_alpha_range | regexgen_digit_range)+ ~ "]" ~ regexgen_multiplier*) }
regexgen_multiselect_expr        = { ("(" ~ regexgen_multiselect_choice_expr ~ ("|" ~ regexgen_multiselect_choice_expr)* ~ ")" ~ regexgen_multiplier*) }
regexgen_multiselect_choice_expr = { (regexgen_range_expr | ASCII_ALPHA+ | ASCII_DIGIT+) }
regexgen_alpha_range             = { ASCII_ALPHA ~ "-" ~ ASCII_ALPHA }
regexgen_digit_range             = { ASCII_DIGIT ~ "-" ~ ASCII_DIGIT }
regexgen_multiplier              = { "{" ~ ASCII_DIGIT+ ~ "}" }

regexgen_non_expr_characters = { ASCII_ALPHA | ASCII_DIGIT | ASCII_CHARS }

// Define a number
number        = { "-"? ~ ASCII_DIGIT+ }
double_number = { "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }

// Define a field_name
field_name       = @{ ASCII_ALPHA ~ field_characters* }
field_characters =  { ASCII_ALPHA | ASCII_DIGIT | FIELD_NAME_CHARACTERS }

// Define whitespace
WS = _{ " " | "\t" }
// Define the newline character
NL = _{ "\n" | "\r" | "\r\n" }

WSNL = _{ WS | NL }

// Define the end of input
END = { !ANY }

// ASCII character rules
ASCII_ALPHA           =  { 'a'..'z' | 'A'..'Z' }
ASCII_DIGIT           =  { '0'..'9'}
ASCII_CHARS           =  { ":" | "." | "-" | "_" | "(" | ")" | "+" | "/" | "<" | "=" | ">" | "@" | "[" | "]" | "^" | "|" | "~" }
FIELD_NAME_CHARACTERS =  { "." | "-" | "_" }

// regex = { "regexgen" ~ whitespace ~ ("(" ~ string ~ ")") }
